# =====================================================================
# TEMPLATE ONLY - DO NOT PUT REAL SECRETS IN THIS FILE
# Copy this file to `.env.local` and add your real credentials there.
# `.env.local` is ignored by Git and will NEVER be pushed to GitHub.
# =====================================================================

# Email.js Configuration (For Contact Form)
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# Google Generative AI (Gemini Chatbot)
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# Portfolio Configuration
REACT_APP_SITE_TITLE=Sabyasachi Samal - Portfolio
REACT_APP_SITE_DESCRIPTION=Full Stack Developer & Java Developer Portfolio

# API Endpoints
REACT_APP_API_URL=http://localhost:5000
REACT_APP_FORM_ENDPOINT=/api/contact

# Analytics (Optional)
REACT_APP_GOOGLE_ANALYTICS_ID=

# Social Links
REACT_APP_GITHUB_URL=https://github.com/sabya18-dev
REACT_APP_LINKEDIN_URL=https://www.linkedin.com/in/sabyasachi-samal-993896303/
REACT_APP_TWITTER_URL=https://x.com/amsavyasachi

# Razorpay Configuration (For DSA Placement Preparation Sheet)
# Get your keys from: https://dashboard.razorpay.com/app/keys
REACT_APP_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# Webhook Secret from Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
PORT=5000
